# theme = gruvbox-material 
# theme = Monokai Remastered 
theme = Carbonfox 

font-size = 14 
mouse-hide-while-typing = true 
# Keep macOS window decorations so the window keeps its rounded corners, but
# hide the titlebar. `window-decoration = false` would square the corners.
window-decoration = auto
macos-titlebar-style = hidden

# keybind = global:cmd+/=toggle_quick_terminal 
macos-option-as-alt = true 

background-opacity = 0.75 
background-blur-radius = 20 

window-padding-x = 0 
window-padding-y = 0
window-padding-balance = true
# Uncomment to start each Ghostty window in the tmux "main" session.
# command = /opt/homebrew/bin/tmux new-session -A -s main
