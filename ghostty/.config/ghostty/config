# theme = gruvbox-material 
# theme = Monokai Remastered 
theme = Carbonfox 

font-size = 14 
mouse-hide-while-typing = true 
window-decoration = false 

# keybind = global:cmd+/=toggle_quick_terminal 
macos-option-as-alt = true 

background-opacity = 0.75 
background-blur-radius = 20 

window-padding-x = 0 
window-padding-y = 0
window-padding-balance = true
# Every new Ghostty window attaches to (or creates) the tmux "main" session. The
# first one after login starts the tmux server, which lets tmux-continuum restore
# the last saved sessions automatically.
command = /opt/homebrew/bin/tmux new-session -A -s main
