#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

PROJECTS_FILE="${AGENTCTL_PROJECTS_FILE:-$AGENT_DIR/projects.json}"
SYNC_SCRIPT="${AGENTCTL_SYNC_SCRIPT:-$SCRIPT_DIR/sync-agent-config.sh}"
AGENT_TOOLS_DIR="${AGENT_TOOLS_DIR:-$HOME/00_development/agent-tools}"
FIRSTMATE_DIR="${AGENTCTL_FIRSTMATE_DIR:-$AGENT_TOOLS_DIR/firstmate}"
FIRSTMATE_PIN="8f7b79c77c2198a71a01082215227a64500015e3"
TREEHOUSE_PIN="2.3.0"
GNHF_PIN="0.1.49"
NO_MISTAKES_PIN="1.64.0"
DEFAULT_MAX_ITERATIONS=10

DRY_RUN=0

usage() {
  cat <<'USAGE'
Usage: agentctl [--dry-run] <command> [options]

Commands:
  start
      Launch or attach the Herdr interface. This is the normal entry point.
  doctor
      Check the shared registry, harnesses, Herdr, and adopted upstream tools.
  sync
      Synchronize canonical agent configuration into each harness.
  project <alias> [--visualization <name>]
      Focus a named Herdr workspace, create it if absent, or explicitly open a registered view.
  fleet [--harness pi|claude|codex]
      Start a FirstMate primary from its external checkout with the Herdr backend.
  overnight <alias> [--max-iterations N] [--max-tokens N] [--agent NAME] -- <objective>
      Acquire a durable Treehouse lease and run bounded GNHF there. Never pushes.
  ship <alias>
      Open no-mistakes only when the repository has a project-local .no-mistakes.yaml.

Options:
  --dry-run   Print shell-escaped commands prefixed with "DRY-RUN:" and execute nothing.
  -h, --help  Show this help.

Exit codes: 0 success; 1 failed check/upstream command; 2 usage or registry error;
3 safety precondition; 4 missing dependency.
USAGE
}

die() {
  local code="$1"
  shift
  printf 'agentctl: %s\n' "$*" >&2
  exit "$code"
}

print_command() {
  printf 'DRY-RUN:'
  printf ' %q' "$@"
  printf '\n'
}

run_command() {
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command "$@"
    return 0
  fi
  "$@"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die 4 "required command not found: $1"
}

validate_registry() {
  [ -f "$PROJECTS_FILE" ] || die 2 "project registry not found: $PROJECTS_FILE"
  python3 - "$PROJECTS_FILE" <<'PY' || exit 2
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    registry = json.loads(path.read_text())
except (OSError, json.JSONDecodeError) as exc:
    print(f"agentctl: invalid project registry: {exc}", file=sys.stderr)
    raise SystemExit(1)
if registry.get("schema_version") != 1 or not isinstance(registry.get("projects"), dict):
    print("agentctl: project registry must have schema_version 1 and a projects object", file=sys.stderr)
    raise SystemExit(1)
for alias, project in registry["projects"].items():
    if not isinstance(alias, str) or not alias or not isinstance(project, dict):
        print("agentctl: every project must have a non-empty alias and object value", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(project.get("path"), str) or not isinstance(project.get("label"), str):
        print(f"agentctl: project {alias!r} needs string path and label fields", file=sys.stderr)
        raise SystemExit(1)
    views = project.get("visualizations", {})
    if not isinstance(views, dict) or any(
        not isinstance(name, str) or not isinstance(argv, list) or not argv
        or any(not isinstance(arg, str) or not arg for arg in argv)
        for name, argv in views.items()
    ):
        print(f"agentctl: project {alias!r} visualizations must be non-empty argv arrays", file=sys.stderr)
        raise SystemExit(1)
PY
}

project_field() {
  local alias="$1" field="$2" view="${3:-}"
  python3 - "$PROJECTS_FILE" "$alias" "$field" "$view" <<'PY'
import json
import sys

registry_path, alias, field, view = sys.argv[1:]
projects = json.load(open(registry_path))["projects"]
if alias not in projects:
    print(f"agentctl: unknown project alias: {alias}", file=sys.stderr)
    raise SystemExit(2)
project = projects[alias]
if field == "view":
    command = project.get("visualizations", {}).get(view)
    if command is None:
        print(f"agentctl: project {alias!r} has no visualization {view!r}", file=sys.stderr)
        raise SystemExit(2)
    print("\n".join(command))
else:
    print(project[field])
PY
}

resolve_project() {
  local alias="$1"
  PROJECT_PATH="$(project_field "$alias" path)"
  PROJECT_LABEL="$(project_field "$alias" label)"
  [ -d "$PROJECT_PATH" ] || die 3 "project path does not exist for $alias: $PROJECT_PATH"
}

tool_version() {
  local tool="$1" output
  shift
  if command -v "$tool" >/dev/null 2>&1; then
    output="$("$tool" "$@" 2>&1 || true)"
    printf '  [ok]   %-14s %s\n' "$tool" "$(printf '%s\n' "$output" | tail -1)"
    return 0
  fi
  printf '  [fail] %-14s not found\n' "$tool"
  return 1
}

start_command() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      *) die 2 "unknown start option: $1" ;;
    esac
    shift
  done
  require_command herdr
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command herdr
  elif [ "${HERDR_ENV:-}" = 1 ]; then
    # Already inside the interface: nesting another client would obscure the
    # current session. The command is deliberately idempotent here.
    printf 'Already inside Herdr.\n'
  else
    exec herdr
  fi
}

doctor() {
  local failed=0 alias path actual
  if validate_registry; then
    printf 'Project registry: %s\n' "$PROJECTS_FILE"
    while IFS= read -r alias; do
      path="$(project_field "$alias" path)"
      if [ -d "$path" ]; then
        printf '  [ok]   %-14s %s\n' "$alias" "$path"
      else
        printf '  [fail] %-14s missing: %s\n' "$alias" "$path"
        failed=1
      fi
    done < <(python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["projects"]))' "$PROJECTS_FILE")
  else
    failed=1
  fi

  echo "Runtime tools:"
  tool_version herdr --version || failed=1
  tool_version pi --version || true
  tool_version claude --version || true
  tool_version codex --version || true
  tool_version jq --version || failed=1

  echo "Adopted integrations:"
  if command -v treehouse >/dev/null 2>&1; then
    actual="$(treehouse --version 2>&1 | head -1 | tr -d '[:space:]')"
    if [ "$actual" = "v$TREEHOUSE_PIN" ]; then
      printf '  [ok]   treehouse      %s\n' "$actual"
    else
      printf '  [fail] treehouse      expected v%s; found %s\n' "$TREEHOUSE_PIN" "${actual:-unknown}"
      failed=1
    fi
  else
    printf '  [fail] treehouse      not found (expected v%s)\n' "$TREEHOUSE_PIN"
    failed=1
  fi
  if command -v gnhf >/dev/null 2>&1; then
    actual="$(gnhf --version 2>&1 | head -1)"
    case "$actual" in *"$GNHF_PIN"*) printf '  [ok]   gnhf           %s\n' "$actual" ;; *) printf '  [fail] gnhf           expected %s; found %s\n' "$GNHF_PIN" "$actual"; failed=1 ;; esac
  else
    printf '  [fail] gnhf           not found (expected %s)\n' "$GNHF_PIN"
    failed=1
  fi
  if command -v no-mistakes >/dev/null 2>&1; then
    if actual="$(no-mistakes version 2>/dev/null)"; then
      actual="$(printf '%s\n' "$actual" | head -1)"
    else
      actual="$(no-mistakes --version 2>&1 | head -1)"
    fi
    case "$actual" in *"$NO_MISTAKES_PIN"*) printf '  [ok]   no-mistakes    %s\n' "$actual" ;; *) printf '  [fail] no-mistakes    expected %s; found %s\n' "$NO_MISTAKES_PIN" "$actual"; failed=1 ;; esac
  else
    printf '  [fail] no-mistakes    not found (expected %s)\n' "$NO_MISTAKES_PIN"
    failed=1
  fi
  if [ -d "$FIRSTMATE_DIR/.git" ]; then
    actual="$(git -C "$FIRSTMATE_DIR" rev-parse HEAD 2>/dev/null || true)"
    if [ "$actual" = "$FIRSTMATE_PIN" ] && [ "$(tr -d '[:space:]' < "$FIRSTMATE_DIR/config/backend" 2>/dev/null || true)" = herdr ]; then
      printf '  [ok]   firstmate      %s (Herdr backend)\n' "$actual"
    else
      printf '  [fail] firstmate      expected %s with config/backend=herdr; found %s\n' "$FIRSTMATE_PIN" "${actual:-unknown}"
      failed=1
    fi
  else
    printf '  [fail] firstmate      checkout missing: %s\n' "$FIRSTMATE_DIR"
    failed=1
  fi

  if [ "$failed" -ne 0 ]; then
    echo "Run agent/scripts/install-agent-tools.sh --tools, then re-run doctor." >&2
    return 1
  fi
}

sync_config() {
  [ -x "$SYNC_SCRIPT" ] || die 3 "sync script is not executable: $SYNC_SCRIPT"
  run_command "$SYNC_SCRIPT"
}

project_command() {
  [ $# -ge 1 ] || die 2 "project requires an alias"
  local alias="$1" visualization=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --visualization) [ $# -ge 2 ] || die 2 "--visualization requires a name"; visualization="$2"; shift ;;
      *) die 2 "unknown project option: $1" ;;
    esac
    shift
  done
  validate_registry
  resolve_project "$alias"
  if [ -n "$visualization" ]; then
    local view_output
    local -a view_command=()
    view_output="$(project_field "$alias" view "$visualization")"
    while IFS= read -r argument; do view_command+=("$argument"); done <<< "$view_output"
    if [ "$DRY_RUN" -eq 0 ]; then require_command "${view_command[0]}"; fi
    if [ "$DRY_RUN" -eq 1 ]; then
      printf 'DRY-RUN: cd %q &&' "$PROJECT_PATH"
      printf ' %q' "${view_command[@]}"
      printf '\n'
    else
      (cd "$PROJECT_PATH" && "${view_command[@]}")
    fi
    return
  fi
  if [ "$DRY_RUN" -eq 0 ]; then require_command herdr; fi
  if [ "$DRY_RUN" -eq 1 ]; then
    run_command herdr workspace create --cwd "$PROJECT_PATH" --label "$PROJECT_LABEL" --focus
    return
  fi

  local workspaces workspace_id
  workspaces="$(herdr workspace list)"
  workspace_id="$(python3 -c '
import json, sys

target_path, target_label, payload = sys.argv[1:]
document = json.loads(payload)
matches = []

def visit(value):
    if isinstance(value, dict):
        workspace_id = value.get("workspace_id")
        label = value.get("label") or value.get("name")
        cwd = value.get("cwd") or value.get("root") or value.get("path")
        if workspace_id and (cwd == target_path or (cwd is None and label == target_label)):
            matches.append(str(workspace_id))
        for child in value.values():
            visit(child)
    elif isinstance(value, list):
        for child in value:
            visit(child)

visit(document)
unique = list(dict.fromkeys(matches))
if len(unique) > 1:
    print(f"agentctl: multiple Herdr workspaces match {target_label!r}", file=sys.stderr)
    raise SystemExit(1)
if unique:
    print(unique[0])
' "$PROJECT_PATH" "$PROJECT_LABEL" "$workspaces")"
  if [ -n "$workspace_id" ]; then
    herdr workspace focus "$workspace_id"
  else
    herdr workspace create --cwd "$PROJECT_PATH" --label "$PROJECT_LABEL" --focus
  fi
}

fleet_command() {
  local harness=pi
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --harness) [ $# -ge 2 ] || die 2 "--harness requires a name"; harness="$2"; shift ;;
      *) die 2 "unknown fleet option: $1" ;;
    esac
    shift
  done
  case "$harness" in pi|claude|codex) ;; *) die 2 "unsupported FirstMate harness: $harness" ;; esac
  if [ "$DRY_RUN" -eq 0 ]; then
    [ -d "$FIRSTMATE_DIR/.git" ] || die 3 "FirstMate checkout missing: $FIRSTMATE_DIR (run install-agent-tools.sh --tools)"
  fi
  if [ "$DRY_RUN" -eq 0 ]; then require_command "$harness"; fi
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: cd %q && FM_BACKEND=herdr %q\n' "$FIRSTMATE_DIR" "$harness"
  else
    (cd "$FIRSTMATE_DIR" && FM_BACKEND=herdr "$harness")
  fi
}

overnight_command() {
  [ $# -ge 1 ] || die 2 "overnight requires a project alias"
  local alias="$1" max_iterations="$DEFAULT_MAX_ITERATIONS" max_tokens="" agent="" objective=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --max-iterations) [ $# -ge 2 ] || die 2 "--max-iterations requires a value"; max_iterations="$2"; shift ;;
      --max-tokens) [ $# -ge 2 ] || die 2 "--max-tokens requires a value"; max_tokens="$2"; shift ;;
      --agent) [ $# -ge 2 ] || die 2 "--agent requires a name"; agent="$2"; shift ;;
      --) shift; objective="$*"; break ;;
      -*) die 2 "unsupported overnight option: $1" ;;
      *) objective="${objective:+$objective }$1" ;;
    esac
    shift
  done
  [[ "$max_iterations" =~ ^[1-9][0-9]*$ ]] || die 2 "--max-iterations must be a positive integer"
  [ -z "$max_tokens" ] || [[ "$max_tokens" =~ ^[1-9][0-9]*$ ]] || die 2 "--max-tokens must be a positive integer"
  [ -n "$objective" ] || die 2 "overnight requires a non-empty objective"
  validate_registry
  resolve_project "$alias"
  [ -d "$PROJECT_PATH/.git" ] || die 3 "GNHF requires a Git repository: $PROJECT_PATH"
  local lease_holder="agentctl-overnight:$alias:$$"
  local -a command=(gnhf --max-iterations "$max_iterations")
  [ -z "$max_tokens" ] || command+=(--max-tokens "$max_tokens")
  [ -z "$agent" ] || command+=(--agent "$agent")
  command+=("$objective")
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: cd %q && treehouse get --lease --lease-holder %q --json\n' "$PROJECT_PATH" "$lease_holder"
    printf 'DRY-RUN: cd %q &&' '<treehouse-worktree>'
    printf ' %q' "${command[@]}"
    printf '\n'
    return 0
  fi

  require_command treehouse
  require_command jq
  require_command gnhf
  local allocation lease_fields worktree lease_id project_root worktree_root status=0
  allocation="$(cd "$PROJECT_PATH" && treehouse get --lease --lease-holder "$lease_holder" --json)" || \
    die 1 "Treehouse could not allocate an overnight worktree"
  lease_fields="$(printf '%s' "$allocation" | jq -er '[.path, .lease_id] | @tsv')" || \
    die 1 "Treehouse returned an unreadable lease; inspect 'treehouse status' in $PROJECT_PATH"
  IFS=$'\t' read -r worktree lease_id <<< "$lease_fields"
  [ -d "$worktree" ] || die 1 "Treehouse reported a missing worktree: $worktree"
  project_root="$(cd "$PROJECT_PATH" && pwd -P)"
  worktree_root="$(cd "$worktree" && pwd -P)"
  [ "$worktree_root" != "$project_root" ] || die 3 "Treehouse returned the primary checkout instead of an isolated worktree"

  (cd "$worktree_root" && "${command[@]}") || status=$?
  printf 'Treehouse lease retained: %s\n' "$worktree_root"
  printf 'Return it after the work is landed: (cd %q && treehouse return %q --if-lease-id %q)\n' \
    "$PROJECT_PATH" "$worktree_root" "$lease_id"
  return "$status"
}

ship_command() {
  [ $# -ge 1 ] || die 2 "ship requires a project alias"
  local alias="$1"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in --dry-run) DRY_RUN=1 ;; *) die 2 "unknown ship option: $1" ;; esac
    shift
  done
  validate_registry
  resolve_project "$alias"
  [ -f "$PROJECT_PATH/.no-mistakes.yaml" ] || die 3 "project has not opted in: create and review $PROJECT_PATH/.no-mistakes.yaml"
  if [ "$DRY_RUN" -eq 0 ]; then require_command no-mistakes; fi
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: cd %q && no-mistakes\n' "$PROJECT_PATH"
  else
    (cd "$PROJECT_PATH" && no-mistakes)
  fi
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || { usage >&2; exit 2; }
  local subcommand="$1"
  shift
  case "$subcommand" in
    start) start_command "$@" ;;
    doctor) [ $# -eq 0 ] || die 2 "doctor accepts no arguments"; doctor ;;
    sync) while [ $# -gt 0 ]; do case "$1" in --dry-run) DRY_RUN=1 ;; *) die 2 "unknown sync option: $1" ;; esac; shift; done; sync_config ;;
    project) project_command "$@" ;;
    fleet) fleet_command "$@" ;;
    overnight) overnight_command "$@" ;;
    ship) ship_command "$@" ;;
    -h|--help|help) usage ;;
    *) die 2 "unknown command: $subcommand" ;;
  esac
}

main "$@"
