#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

PROJECTS_FILE="${AGENTCTL_PROJECTS_FILE:-$AGENT_DIR/projects.json}"
SYNC_SCRIPT="${AGENTCTL_SYNC_SCRIPT:-$SCRIPT_DIR/sync-agent-config.sh}"
AGENT_TOOLS_DIR="${AGENT_TOOLS_DIR:-$HOME/00_development/agent-tools}"
FIRSTMATE_DIR="${AGENTCTL_FIRSTMATE_DIR:-$AGENT_TOOLS_DIR/firstmate}"
FIRSTMATE_DISPATCH_TEMPLATE="$AGENT_DIR/firstmate/crew-dispatch.json"
FIRSTMATE_PROJECTS_SCRIPT="$SCRIPT_DIR/firstmate-projects.py"
# shellcheck source=../tools.env
source "$AGENT_DIR/tools.env"
# shellcheck source=python-runtime.sh
source "$SCRIPT_DIR/python-runtime.sh"
DEFAULT_MAX_ITERATIONS=10

DRY_RUN=0

usage() {
  cat <<'USAGE'
Usage: agentctl [--dry-run] <command> [options]

Commands:
  start
      Launch or attach the Herdr interface. This is the normal entry point.
  doctor
      Check the shared registry, harnesses, Herdr, and adopted upstream tools.
  sync
      Synchronize canonical agent configuration into each harness.
  project <alias> [--visualization <name>]
      Focus a named Herdr workspace, create it if absent, or explicitly open a registered view.
  fleet [--harness pi|claude|codex]
      Start a FirstMate primary with Herdr and the managed token-aware dispatch profile.
  overnight <alias> [--max-iterations N] [--max-tokens N] [--agent NAME] -- <objective>
      Acquire a durable Treehouse lease and run bounded GNHF there. Never pushes.
  ship <alias> --intent <goal> [--base-branch main] [--yes] [--no-automerge]
      Run the project-local no-mistakes PR gate, then schedule a guarded GitHub auto-merge.

Options:
  --dry-run   Print shell-escaped commands prefixed with "DRY-RUN:" and execute nothing.
  -h, --help  Show this help.

Exit codes: 0 success; 1 failed check/upstream command; 2 usage or registry error;
3 safety precondition; 4 missing dependency.
USAGE
}

die() {
  local code="$1"
  shift
  printf 'agentctl: %s\n' "$*" >&2
  exit "$code"
}

print_command() {
  printf 'DRY-RUN:'
  printf ' %q' "$@"
  printf '\n'
}

run_command() {
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command "$@"
    return 0
  fi
  "$@" || return 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die 4 "required command not found: $1"
}

ensure_firstmate_projects() {
  [ -f "$FIRSTMATE_PROJECTS_SCRIPT" ] || die 3 "FirstMate project renderer missing: $FIRSTMATE_PROJECTS_SCRIPT"
  local -a args=("$AGENT_PYTHON" "$FIRSTMATE_PROJECTS_SCRIPT" --projects "$PROJECTS_FILE" --firstmate "$FIRSTMATE_DIR")
  [ "$DRY_RUN" -eq 0 ] || args+=(--dry-run)
  "${args[@]}"
}

firstmate_projects_current() {
  [ -f "$FIRSTMATE_PROJECTS_SCRIPT" ] || return 1
  "$AGENT_PYTHON" "$FIRSTMATE_PROJECTS_SCRIPT" --projects "$PROJECTS_FILE" --firstmate "$FIRSTMATE_DIR" --check >/dev/null
}

ensure_firstmate_config() {
  [ -f "$FIRSTMATE_DISPATCH_TEMPLATE" ] || die 3 "FirstMate dispatch template missing: $FIRSTMATE_DISPATCH_TEMPLATE"
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command mkdir -p "$FIRSTMATE_DIR/config"
    printf 'DRY-RUN: write %q with value herdr\n' "$FIRSTMATE_DIR/config/backend"
    print_command install -m 0644 "$FIRSTMATE_DISPATCH_TEMPLATE" "$FIRSTMATE_DIR/config/crew-dispatch.json"
    ensure_firstmate_projects
    return 0
  fi
  mkdir -p "$FIRSTMATE_DIR/config"
  printf 'herdr\n' > "$FIRSTMATE_DIR/config/backend"
  install -m 0644 "$FIRSTMATE_DISPATCH_TEMPLATE" "$FIRSTMATE_DIR/config/crew-dispatch.json"
  ensure_firstmate_projects
}

herdr_pi_integration_current() {
  local status
  status="$(herdr integration status 2>&1)" || return 1
  printf '%s\n' "$status" | grep -qE '^pi: +current([[:space:]]|$)'
}

ensure_herdr_pi_integration() {
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command herdr integration install pi
    print_command herdr integration status
    return 0
  fi
  require_command herdr
  herdr integration install pi || return 1
  if ! herdr_pi_integration_current; then
    printf 'agentctl: Herdr Pi integration is not current after refresh; run `herdr integration status` and restart Pi.\n' >&2
    return 1
  fi
}

validate_registry() {
  [ -f "$PROJECTS_FILE" ] || die 2 "project registry not found: $PROJECTS_FILE"
  "$AGENT_PYTHON" - "$PROJECTS_FILE" <<'PY' || exit 2
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    registry = json.loads(path.read_text())
except (OSError, json.JSONDecodeError) as exc:
    print(f"agentctl: invalid project registry: {exc}", file=sys.stderr)
    raise SystemExit(1)
if not isinstance(registry, dict) or registry.get("schema_version") != 1 or not isinstance(registry.get("projects"), dict) or not registry["projects"]:
    print("agentctl: project registry must have schema_version 1 and a projects object", file=sys.stderr)
    raise SystemExit(1)
for alias, project in registry["projects"].items():
    if not isinstance(alias, str) or not alias or not isinstance(project, dict):
        print("agentctl: every project must have a non-empty alias and object value", file=sys.stderr)
        raise SystemExit(1)
    if any(c.isspace() or c in "[]" for c in alias):
        print(f"agentctl: project alias {alias!r} cannot be rendered in FirstMate data/projects.md", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(project.get("path"), str) or not isinstance(project.get("label"), str):
        print(f"agentctl: project {alias!r} needs string path and label fields", file=sys.stderr)
        raise SystemExit(1)
    if not project["path"].startswith("/") or not project["label"]:
        print(f"agentctl: project {alias!r} needs an absolute path and non-empty label", file=sys.stderr)
        raise SystemExit(1)
    views = project.get("visualizations", {})
    if not isinstance(views, dict) or any(
        not isinstance(name, str) or not isinstance(argv, list) or not argv
        or any(not isinstance(arg, str) or not arg for arg in argv)
        for name, argv in views.items()
    ):
        print(f"agentctl: project {alias!r} visualizations must be non-empty argv arrays", file=sys.stderr)
        raise SystemExit(1)
    delivery = project.get("delivery", {})
    if not isinstance(delivery, dict):
        print(f"agentctl: project {alias!r} delivery must be an object", file=sys.stderr)
        raise SystemExit(1)
    mode = delivery.get("mode", "no-mistakes")
    if mode not in {"no-mistakes", "direct-PR", "local-only", "no-mistakes-prod-only"}:
        print(f"agentctl: project {alias!r} delivery.mode is invalid", file=sys.stderr)
        raise SystemExit(1)
    automerge = delivery.get("automerge", True)
    if not isinstance(automerge, bool):
        print(f"agentctl: project {alias!r} delivery.automerge must be boolean", file=sys.stderr)
        raise SystemExit(1)
    description = delivery.get("description", "")
    if description is None:
        description = ""
    if not isinstance(description, str):
        print(f"agentctl: project {alias!r} delivery.description must be a string", file=sys.stderr)
        raise SystemExit(1)
    values = [alias, project["path"], project["label"], *views.keys(),
              *(arg for argv in views.values() for arg in argv), mode, description]
    if any(any(ord(c) < 32 for c in value) for value in values):
        print("agentctl: registry strings must not contain control characters", file=sys.stderr)
        raise SystemExit(1)
PY
}

project_field() {
  local alias="$1" field="$2" view="${3:-}"
  "$AGENT_PYTHON" - "$PROJECTS_FILE" "$alias" "$field" "$view" <<'PY'
import json
import sys

registry_path, alias, field, view = sys.argv[1:]
projects = json.load(open(registry_path))["projects"]
if alias not in projects:
    print(f"agentctl: unknown project alias: {alias}", file=sys.stderr)
    raise SystemExit(2)
project = projects[alias]
if field == "view":
    command = project.get("visualizations", {}).get(view)
    if command is None:
        print(f"agentctl: project {alias!r} has no visualization {view!r}", file=sys.stderr)
        raise SystemExit(2)
    print("\n".join(command))
else:
    print(project[field])
PY
}

resolve_project() {
  local alias="$1"
  PROJECT_PATH="$(project_field "$alias" path)"
  PROJECT_LABEL="$(project_field "$alias" label)"
  [ -d "$PROJECT_PATH" ] || die 3 "project path does not exist for $alias: $PROJECT_PATH"
}

tool_version() {
  local tool="$1" output
  shift
  if command -v "$tool" >/dev/null 2>&1; then
    if ! output="$("$tool" "$@" 2>&1)" || [ -z "$output" ]; then
      printf '  [fail] %-14s version probe failed\n' "$tool"
      return 1
    fi
    printf '  [ok]   %-14s %s\n' "$tool" "$(printf '%s\n' "$output" | tail -1)"
    return 0
  fi
  printf '  [fail] %-14s not found\n' "$tool"
  return 1
}

axi_helper_status() {
  local tool="$1" expected="$2" actual
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf '  [optional] %-14s not installed (reviewed %s; run install-agent-tools.sh --tools)\n' "$tool" "$expected"
    return 0
  fi
  if ! actual="$("$tool" --version 2>/dev/null | head -1 | tr -d '[:space:]')" || [ -z "$actual" ]; then
    printf '  [warn] %-14s version probe unavailable (reviewed %s)\n' "$tool" "$expected"
    return 0
  fi
  if [ "$actual" = "$expected" ]; then
    printf '  [ok]   %-14s %s\n' "$tool" "$actual"
  else
    printf '  [warn] %-14s expected %s; found %s (run install-agent-tools.sh --tools)\n' "$tool" "$expected" "$actual"
  fi
}

start_command() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      *) die 2 "unknown start option: $1" ;;
    esac
    shift
  done
  require_command herdr
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command herdr
  elif [ "${HERDR_ENV:-}" = 1 ]; then
    # Already inside the interface: nesting another client would obscure the
    # current session. The command is deliberately idempotent here.
    printf 'Already inside Herdr.\n'
  else
    run_command herdr
  fi
}

doctor() {
  local failed=0 alias path actual
  echo "Configuration:"
  "$SYNC_SCRIPT" --check-installed || failed=1
  "$AGENT_PYTHON" "$SCRIPT_DIR/agent_config.py" --inventory || failed=1
  if validate_registry; then
    printf 'Project registry: %s\n' "$PROJECTS_FILE"
    while IFS= read -r alias; do
      path="$(project_field "$alias" path)"
      if [ -d "$path" ]; then
        printf '  [ok]   %-14s %s\n' "$alias" "$path"
      else
        printf '  [fail] %-14s missing: %s\n' "$alias" "$path"
        failed=1
      fi
    done < <("$AGENT_PYTHON" -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["projects"]))' "$PROJECTS_FILE")
  else
    failed=1
  fi

  echo "Runtime tools:"
  if tool_version herdr --version; then
    if herdr_pi_integration_current; then
      printf '  [ok]   herdr-pi      integration current\n'
    else
      printf '  [fail] herdr-pi      run: herdr integration install pi && herdr integration status\n'
      failed=1
    fi
  else
    failed=1
  fi
  for harness in pi claude codex; do
    if command -v "$harness" >/dev/null 2>&1; then
      tool_version "$harness" --version || failed=1
    else
      printf '  [optional] %s not installed\n' "$harness"
    fi
  done
  tool_version jq --version || failed=1

  echo "Adopted integrations:"
  if command -v treehouse >/dev/null 2>&1; then
    actual="$(treehouse --version 2>&1)" || { printf "  [fail] treehouse version probe failed\n"; return 1; }
    actual="$(printf %s "$actual" | tr -d '[:space:]')"
    if [ "$actual" = "v$TREEHOUSE_VERSION" ]; then
      printf '  [ok]   treehouse      %s\n' "$actual"
    else
      printf '  [fail] treehouse      expected v%s; found %s\n' "$TREEHOUSE_VERSION" "${actual:-unknown}"
      failed=1
    fi
  else
    printf '  [fail] treehouse      not found (expected v%s)\n' "$TREEHOUSE_VERSION"
    failed=1
  fi
  if command -v gnhf >/dev/null 2>&1; then
    actual="$(gnhf --version 2>&1)" || { printf "  [fail] gnhf version probe failed\n"; return 1; }
    case "$actual" in "$GNHF_VERSION") printf '  [ok]   gnhf           %s\n' "$actual" ;; *) printf '  [fail] gnhf           expected %s; found %s\n' "$GNHF_VERSION" "$actual"; failed=1 ;; esac
  else
    printf '  [optional] gnhf       not installed (reviewed %s)\n' "$GNHF_VERSION"
  fi
  if command -v no-mistakes >/dev/null 2>&1; then
    if actual="$(no-mistakes version 2>/dev/null)"; then
      actual="$(printf '%s\n' "$actual" | head -1)"
    else
      actual="$(no-mistakes --version 2>&1)" || { printf '  [fail] no-mistakes version probe failed\n'; return 1; }
      actual="$(printf '%s\n' "$actual" | head -1)"
    fi
    case "$actual" in *"$NO_MISTAKES_VERSION"*) printf '  [ok]   no-mistakes    %s\n' "$actual" ;; *) printf '  [fail] no-mistakes    expected %s; found %s\n' "$NO_MISTAKES_VERSION" "$actual"; failed=1 ;; esac
  else
    printf '  [optional] no-mistakes not installed (reviewed %s)\n' "$NO_MISTAKES_VERSION"
  fi
  if [ -e "$FIRSTMATE_DIR/.git" ]; then
    actual="$(git -C "$FIRSTMATE_DIR" rev-parse HEAD 2>/dev/null || true)"
    if [ "$actual" = "$FIRSTMATE_COMMIT" ] \
      && [ "$(tr -d '[:space:]' < "$FIRSTMATE_DIR/config/backend" 2>/dev/null || true)" = herdr ] \
      && cmp -s "$FIRSTMATE_DISPATCH_TEMPLATE" "$FIRSTMATE_DIR/config/crew-dispatch.json" \
      && firstmate_projects_current; then
      printf '  [ok]   firstmate      %s (Herdr backend, token-aware dispatch, no-mistakes +yolo projects)\n' "$actual"
    else
      printf '  [fail] firstmate      expected %s with config/backend=herdr, managed config/crew-dispatch.json, and managed data/projects.md; found %s\n' "$FIRSTMATE_COMMIT" "${actual:-unknown}"
      failed=1
    fi
  else
    printf '  [optional] firstmate  checkout absent: %s\n' "$FIRSTMATE_DIR"
  fi

  echo "AXI helpers:"
  axi_helper_status gh-axi "$GH_AXI_VERSION"
  axi_helper_status chrome-devtools-axi "$CHROME_DEVTOOLS_AXI_VERSION"
  axi_helper_status lavish-axi "$LAVISH_AXI_VERSION"
  axi_helper_status quota-axi "$QUOTA_AXI_VERSION"

  if [ "$failed" -ne 0 ]; then
    echo "Run agent/scripts/install-agent-tools.sh --tools, then re-run doctor." >&2
    return 1
  fi
}

sync_config() {
  [ -x "$SYNC_SCRIPT" ] || die 3 "sync script is not executable: $SYNC_SCRIPT"
  run_command "$SYNC_SCRIPT"
}

project_command() {
  [ $# -ge 1 ] || die 2 "project requires an alias"
  local alias="$1" visualization=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --visualization) [ $# -ge 2 ] || die 2 "--visualization requires a name"; visualization="$2"; shift ;;
      *) die 2 "unknown project option: $1" ;;
    esac
    shift
  done
  validate_registry
  resolve_project "$alias"
  if [ -n "$visualization" ]; then
    local view_output
    local -a view_command=()
    view_output="$(project_field "$alias" view "$visualization")"
    while IFS= read -r argument; do view_command+=("$argument"); done <<< "$view_output"
    if [ "$DRY_RUN" -eq 0 ]; then require_command "${view_command[0]}"; fi
    if [ "$DRY_RUN" -eq 1 ]; then
      printf 'DRY-RUN: cd %q &&' "$PROJECT_PATH"
      printf ' %q' "${view_command[@]}"
      printf '\n'
    else
      (cd "$PROJECT_PATH" && "${view_command[@]}") || return 1
    fi
    return
  fi
  if [ "$DRY_RUN" -eq 0 ]; then require_command herdr; fi
  if [ "$DRY_RUN" -eq 1 ]; then
    run_command herdr workspace create --cwd "$PROJECT_PATH" --label "$PROJECT_LABEL" --focus
    return
  fi

  local workspaces workspace_id
  workspaces="$(herdr workspace list)" || return 1
  workspace_id="$("$AGENT_PYTHON" -c '
import json, sys

target_path, target_label, payload = sys.argv[1:]
document = json.loads(payload)
matches = []

def visit(value):
    if isinstance(value, dict):
        workspace_id = value.get("workspace_id")
        label = value.get("label") or value.get("name")
        cwd = value.get("cwd") or value.get("root") or value.get("path")
        if workspace_id and (cwd == target_path or (cwd is None and label == target_label)):
            matches.append(str(workspace_id))
        for child in value.values():
            visit(child)
    elif isinstance(value, list):
        for child in value:
            visit(child)

visit(document)
unique = list(dict.fromkeys(matches))
if len(unique) > 1:
    print(f"agentctl: multiple Herdr workspaces match {target_label!r}", file=sys.stderr)
    raise SystemExit(1)
if unique:
    print(unique[0])
' "$PROJECT_PATH" "$PROJECT_LABEL" "$workspaces")"
  if [ -n "$workspace_id" ]; then
    run_command herdr workspace focus "$workspace_id"
  else
    run_command herdr workspace create --cwd "$PROJECT_PATH" --label "$PROJECT_LABEL" --focus
  fi
}

fleet_command() {
  local harness=pi
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --harness) [ $# -ge 2 ] || die 2 "--harness requires a name"; harness="$2"; shift ;;
      *) die 2 "unknown fleet option: $1" ;;
    esac
    shift
  done
  case "$harness" in pi|claude|codex) ;; *) die 2 "unsupported FirstMate harness: $harness" ;; esac
  if [ "$DRY_RUN" -eq 0 ]; then
    [ -d "$FIRSTMATE_DIR/.git" ] || die 3 "FirstMate checkout missing: $FIRSTMATE_DIR (run install-agent-tools.sh --tools)"
  fi
  if [ "$harness" = pi ]; then
    ensure_herdr_pi_integration || return 1
  fi
  ensure_firstmate_config
  if [ "$DRY_RUN" -eq 0 ]; then require_command "$harness"; fi
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: cd %q && FM_BACKEND=herdr %q\n' "$FIRSTMATE_DIR" "$harness"
  else
    (cd "$FIRSTMATE_DIR" && FM_BACKEND=herdr "$harness") || return 1
  fi
}

overnight_command() {
  [ $# -ge 1 ] || die 2 "overnight requires a project alias"
  local alias="$1" max_iterations="$DEFAULT_MAX_ITERATIONS" max_tokens="" agent="" objective=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --max-iterations) [ $# -ge 2 ] || die 2 "--max-iterations requires a value"; max_iterations="$2"; shift ;;
      --max-tokens) [ $# -ge 2 ] || die 2 "--max-tokens requires a value"; max_tokens="$2"; shift ;;
      --agent) [ $# -ge 2 ] || die 2 "--agent requires a name"; agent="$2"; shift ;;
      --) shift; objective="$*"; break ;;
      -*) die 2 "unsupported overnight option: $1" ;;
      *) objective="${objective:+$objective }$1" ;;
    esac
    shift
  done
  [[ "$max_iterations" =~ ^[1-9][0-9]*$ ]] || die 2 "--max-iterations must be a positive integer"
  [ -z "$max_tokens" ] || [[ "$max_tokens" =~ ^[1-9][0-9]*$ ]] || die 2 "--max-tokens must be a positive integer"
  [ -n "$objective" ] || die 2 "overnight requires a non-empty objective"
  validate_registry
  resolve_project "$alias"
  local source_head
  source_head="$(git -C "$PROJECT_PATH" rev-parse --verify HEAD 2>/dev/null)" || die 3 "GNHF requires a committed Git repository: $PROJECT_PATH"
  [ -z "$(git -C "$PROJECT_PATH" status --porcelain)" ] || die 3 "overnight requires a clean source checkout; commit the intended starting state first"
  local lease_holder="agentctl-overnight:$alias:$$"
  local -a command=(gnhf --max-iterations "$max_iterations" --max-rate-limit-wait 0)
  [ -z "$max_tokens" ] || command+=(--max-tokens "$max_tokens")
  [ -z "$agent" ] || command+=(--agent "$agent")
  command+=("$objective")
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: cd %q && treehouse get --lease --lease-holder %q --json\n' "$PROJECT_PATH" "$lease_holder"
    printf 'DRY-RUN: git -C %q merge --ff-only %q\n' '<treehouse-worktree>' "$source_head"
    printf 'DRY-RUN: cd %q &&' '<treehouse-worktree>'
    printf ' %q' "${command[@]}"
    printf '\n'
    return 0
  fi

  require_command treehouse
  require_command jq
  require_command gnhf
  [ "$(gnhf --version)" = "$GNHF_VERSION" ] || die 3 "GNHF version differs from the reviewed pin; run doctor"
  # Execution permissions are explicit in the managed GNHF adapter (§2.4).
  "$AGENT_PYTHON" "$SCRIPT_DIR/agent_config.py" --check-gnhf "$agent" || die 3 "GNHF execution mode is missing or unsafe; sync configuration first"
  local allocation lease_fields worktree lease_id project_root worktree_root status=0
  allocation="$(cd "$PROJECT_PATH" && treehouse get --lease --lease-holder "$lease_holder" --json)" || \
    die 1 "Treehouse could not allocate an overnight worktree"
  lease_fields="$(printf '%s' "$allocation" | jq -er '[.path, .lease_id] | @tsv')" || \
    die 1 "Treehouse returned an unreadable lease; inspect 'treehouse status' in $PROJECT_PATH"
  IFS=$'\t' read -r worktree lease_id <<< "$lease_fields"
  [ -d "$worktree" ] || die 1 "Treehouse reported a missing worktree: $worktree"
  project_root="$(cd "$PROJECT_PATH" && pwd -P)"
  worktree_root="$(cd "$worktree" && pwd -P)"
  [ "$worktree_root" != "$project_root" ] || die 3 "Treehouse returned the primary checkout instead of an isolated worktree"

  printf 'Treehouse lease retained: %s\n' "$worktree_root"
  printf 'Return it after the work is landed: (cd %q && treehouse return %q --if-lease-id %q)\n' \
    "$PROJECT_PATH" "$worktree_root" "$lease_id"
  local project_common worktree_common
  project_common="$(git -C "$PROJECT_PATH" rev-parse --path-format=absolute --git-common-dir)"
  worktree_common="$(git -C "$worktree_root" rev-parse --path-format=absolute --git-common-dir)" || die 3 "Treehouse returned a non-repository"
  [ "$project_common" = "$worktree_common" ] || die 3 "Treehouse returned a different repository"
  [ -z "$(git -C "$worktree_root" status --porcelain)" ] || die 3 "Treehouse returned a dirty worktree"
  # Treehouse starts at its configured base; preserve the requested project's actual revision.
  git -C "$worktree_root" merge --ff-only "$source_head" || die 3 "source revision cannot fast-forward the lease; inspect the retained worktree"
  (cd "$worktree_root" && "${command[@]}" < /dev/null) || status=1
  return "$status"
}

ship_command() {
  [ $# -ge 1 ] || die 2 "ship requires a project alias"
  local alias="$1" base_branch=main intent="" auto_yes=0 automerge=1
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --base-branch) [ $# -ge 2 ] || die 2 "--base-branch requires a name"; base_branch="$2"; shift ;;
      --intent) [ $# -ge 2 ] || die 2 "--intent requires a goal"; intent="$2"; shift ;;
      --yes) auto_yes=1 ;;
      --no-automerge) automerge=0 ;;
      *) die 2 "unknown ship option: $1" ;;
    esac
    shift
  done
  validate_registry
  resolve_project "$alias"
  [ -f "$PROJECT_PATH/.no-mistakes.yaml" ] || die 3 "project has not opted in: create and review $PROJECT_PATH/.no-mistakes.yaml"
  local -a run_args=(no-mistakes axi run --base-branch "$base_branch" --intent "${intent:-<required-intent>}")
  [ "$auto_yes" -eq 0 ] || run_args+=(--yes)
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: cd %q && no-mistakes init\n' "$PROJECT_PATH"
    printf 'DRY-RUN: cd %q &&' "$PROJECT_PATH"
    printf ' %q' "${run_args[@]}"
    printf '\n'
    if [ "$automerge" -eq 1 ]; then
      printf 'DRY-RUN: cd %q && no-mistakes axi status\n' "$PROJECT_PATH"
      printf 'DRY-RUN: cd %q && gh-axi pr merge <no-mistakes-pr-number> --squash --delete-branch --auto\n' "$PROJECT_PATH"
    fi
    return 0
  fi
  [ -n "$intent" ] || die 2 "ship requires --intent so no-mistakes can judge the change against the user's goal"
  require_command git
  require_command no-mistakes
  [ "$automerge" -eq 0 ] || require_command gh-axi
  local current_branch
  current_branch="$(git -C "$PROJECT_PATH" branch --show-current 2>/dev/null)" || die 3 "ship requires a Git repository: $PROJECT_PATH"
  [ -n "$current_branch" ] || die 3 "ship requires a named feature branch, not a detached HEAD"
  [ "$current_branch" != "$base_branch" ] || die 3 "ship must run from a feature branch, not $base_branch"
  [ -z "$(git -C "$PROJECT_PATH" status --porcelain)" ] || die 3 "ship requires clean committed work before no-mistakes starts"
  (cd "$PROJECT_PATH" && no-mistakes init) || return 1
  local tmp pr_number
  tmp="$(mktemp "${TMPDIR:-/tmp}/agentctl-ship.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN
  if ! (cd "$PROJECT_PATH" && "${run_args[@]}") 2>&1 | tee "$tmp"; then
    return 1
  fi
  if [ "$automerge" -eq 1 ]; then
    if ! (cd "$PROJECT_PATH" && no-mistakes axi status) 2>&1 | tee -a "$tmp"; then
      return 1
    fi
    pr_number="$($AGENT_PYTHON - "$tmp" <<'PY'
from pathlib import Path
import re
import sys
text = Path(sys.argv[1]).read_text(errors="replace")
matches = re.findall(r"https://[^\s)]+/(?:pull|merge_requests)/(\d+)", text)
if matches:
    print(matches[-1])
PY
)"
    if [ -z "$pr_number" ]; then
      printf 'agentctl: no no-mistakes PR URL found yet; continue the active gate before auto-merge.\n' >&2
      return 0
    fi
    (cd "$PROJECT_PATH" && gh-axi pr merge "$pr_number" --squash --delete-branch --auto) || return 1
  fi
  trap - RETURN
  rm -f "$tmp"
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || { usage >&2; exit 2; }
  local subcommand="$1"
  shift
  case "$subcommand" in
    start) start_command "$@" ;;
    doctor) [ $# -eq 0 ] || die 2 "doctor accepts no arguments"; doctor ;;
    sync) while [ $# -gt 0 ]; do case "$1" in --dry-run) DRY_RUN=1 ;; *) die 2 "unknown sync option: $1" ;; esac; shift; done; sync_config ;;
    project) project_command "$@" ;;
    fleet) fleet_command "$@" ;;
    overnight) overnight_command "$@" ;;
    ship) ship_command "$@" ;;
    -h|--help|help) usage ;;
    *) die 2 "unknown command: $subcommand" ;;
  esac
}

main "$@"
