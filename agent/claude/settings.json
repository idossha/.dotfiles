{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Skill(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "ToolSearch(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "TaskUpdate(*)",
      "CronCreate(*)",
      "CronDelete(*)",
      "CronList(*)",
      "AskUserQuestion(*)",
      "EnterPlanMode(*)",
      "ExitPlanMode(*)",
      "mcp__openalex__search_works",
      "mcp__openalex__search_authors",
      "mcp__openalex__get_author_works",
      "mcp__openalex__search_by_topic",
      "Bash(git rm:*)",
      "Bash(git add:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "TaskCreate(*)",
      "EnterWorktree(*)",
      "ExitWorktree(*)",
      "Bash(git worktree add:*)",
      "Bash(herdr worktree create:*)",
      "Bash(gnhf --worktree:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/idohaber/.local/bin/idosleep",
            "args": [
              "hook",
              "SessionStart"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/idohaber/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/idohaber/.local/bin/idosleep",
            "args": [
              "hook",
              "UserPromptSubmit"
            ],
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/idohaber/.local/bin/idosleep",
            "args": [
              "hook",
              "Stop"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/idohaber/.local/bin/idosleep",
            "args": [
              "hook",
              "PreCompact"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/idohaber/.local/bin/idosleep",
            "args": [
              "hook",
              "SessionEnd"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ti-toolbox@ti-toolbox": true,
    "agentic-rules@agentic-rules": false
  },
  "extraKnownMarketplaces": {
    "ti-toolbox": {
      "source": {
        "source": "github",
        "repo": "idossha/TI-Toolbox"
      },
      "autoUpdate": true
    },
    "agentic-rules": {
      "source": {
        "source": "git",
        "url": "git@github.com:idossha/agentic-rules.git"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "low"
    },
    "claude-opus-5": {
      "effortLevel": "low"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": false,
  "agentPushNotifEnabled": true
}
